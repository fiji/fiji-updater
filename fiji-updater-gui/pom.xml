	<groupId>sc.fiji</groupId>
	<artifactId>fiji-updater-gui</artifactId>
	<version>3.0.0-SNAPSHOT</version>

	<name>Fiji Updater GUI</name>
	<description>Swing user interface for the Fiji Updater.</description>
	<url>https://imagej.net/plugins/updater</url>
	<inceptionYear>2009</inceptionYear>
	<organization>
		<name>Fiji</name>
		<url>https://fiji.sc/</url>
	</organization>

	<licenses>
		<license>
